# Copie este arquivo para .env e ajuste o valor.
# Local (MongoDB Community Server, sem autenticação):
DATABASE_URL=mongodb://localhost:27017/backend-nestjs-aula18

# Atlas (exemplo de formato; nunca commite a URI real):
# DATABASE_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/nomeDoBanco

# Aula 30: chave que assina os tokens JWT. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA commite o valor real.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Aula 33: chave que assina os Refresh Tokens (DIFERENTE da JWT_SECRET).
# Gere outra com o mesmo comando. NUNCA commite o valor real.
JWT_REFRESH_SECRET=troque-por-outra-chave-longa-e-aleatoria

# Aula 33 (opcional): validade do Access Token. Padrão: 15m.
# Para testar a expiração use 10s e volte para 15m depois.
# JWT_ACCESS_EXPIRES_IN=15m
