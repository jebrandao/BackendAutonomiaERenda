# Aula 36: modelo do .env.production. Copie para .env.production
# (que NUNCA vai para o Git) e preencha com os valores REAIS.
#
# Importante: NODE_ENV=production precisa existir no AMBIENTE do
# processo, antes do app subir (veja o comando de start abaixo).
# Esta linha serve só de documentação e de segurança extra.
NODE_ENV=production

# Porta de produção (80/443 em servidor real; aqui, uma livre).
PORT=3001

# Banco de PRODUÇÃO: diferente do de desenvolvimento.
# Local (só para estudo):
DATABASE_URL=mongodb://localhost:27017/backend-nestjs-producao
# Atlas (formato; nunca commite a URI real):
# DATABASE_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/nomeDoBanco

# Chaves de alta complexidade (mínimo 32 caracteres) e DIFERENTES
# entre si. Gere cada uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-de-producao
JWT_REFRESH_SECRET=troque-por-outra-chave-de-producao

# Validade do Access Token (padrão 15m).
# JWT_ACCESS_EXPIRES_IN=15m

# Aula 37: conta Admin criada pelo seed (npm run seed).
# ATENÇÃO: valores com "#", espaço ou outro símbolo PRECISAM de
# aspas. Sem elas o dotenv trata "#" como comentário e corta o
# valor em silêncio (Adm1n#Abc vira só "Adm1n").
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_SENHA="troque-por-uma-senha-forte-com-12-ou-mais-caracteres"

# Aula 38: ajustes para rodar atrás de um proxy ou balanceador
# (Nginx, Render...). Na Cloud, defina estes valores no PAINEL da
# plataforma, e não em arquivo no servidor.
# TRUST_PROXY=1
# KEEP_ALIVE_TIMEOUT_MS=65000
# HOST=127.0.0.1
